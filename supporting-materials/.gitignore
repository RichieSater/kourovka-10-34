# Kept for tools that treat supporting-materials as their working root.
# The repository-root .gitignore is authoritative.  Keep this file deliberately
# narrow: audit reports, CSV/JSON manifests, clean-room logs, formal sources,
# environment locks, and computation certificates are release evidence and
# MUST remain visible to Git.
.DS_Store

# The release PDF is built at repository root.  Only the duplicate paper-tree
# build and TeX auxiliaries are disposable.
paper/kourovka1034.pdf
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# Never add broad rules such as *.log, *.json, *.csv, audit/, formal/,
# computations/environment/, or computations/certificates/ here.
