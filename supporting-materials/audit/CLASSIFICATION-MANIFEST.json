{
  "schema_version": 1,
  "independence_note": "This inventory is a hand-authored transcription of the published CFSG family list; it is not generated by GAP or by the finite sweeps.",
  "classification_source": {
    "key": "GLS1",
    "citation": "D. Gorenstein, R. Lyons, R. Solomon, The Classification of the Finite Simple Groups, Number 1, AMS Mathematical Surveys and Monographs 40.1 (1994)",
    "pinpoint_status": "CITED-PASS",
    "obligation": "SRC-CFSG-PINPOINT",
    "pinpoint": "Chapter 1, Table I, pp. 8--10",
    "independent_corroboration": "Roney-Dougal 2022, Theorem 1.1, author-manuscript pp. 1--2"
  },
  "families": [
    {
      "id": "alternating",
      "name": "A_n",
      "parameters": "n >= 5",
      "route": "THM-AN",
      "exceptions": [
        "MAX-AN-LE14"
      ]
    },
    {
      "id": "psl2",
      "name": "PSL(2,q)",
      "parameters": "q = p^f >= 4",
      "route": "THM-PSL2",
      "exceptions": [
        "SIMP-PSL2-2-3",
        "MAX-PSL2-LE11",
        "Z-PSL2-8"
      ]
    },
    {
      "id": "psl_rank_ge3",
      "name": "PSL(n,q)",
      "parameters": "n >= 3; exclude (n,q)=(3,2) only as an exceptional isomorphism, not from simplicity",
      "route": "THM-GRAPH",
      "exceptions": [
        "Z-PSL3-4",
        "Z-PSL6-2",
        "MAX-PSL3-LE4"
      ]
    },
    {
      "id": "psu3",
      "name": "PSU(3,q)",
      "parameters": "q >= 3",
      "route": "THM-TWISTED-RANK1",
      "exceptions": [
        "SIMP-PSU3-2",
        "MAX-PSU3-SMALL"
      ]
    },
    {
      "id": "psu_rank_ge4",
      "name": "PSU(n,q) = ^2A_(n-1)(q)",
      "parameters": "n >= 4",
      "route": "THM-TWISTED-RANKGE2",
      "exceptions": [
        "Z-PSU4-2",
        "ISO-PSU4-2"
      ]
    },
    {
      "id": "symplectic",
      "name": "PSp(2n,q) = C_n(q)",
      "parameters": "n >= 2, excluding (n,q)=(2,2)",
      "route": "THM-NOGRAPH for n>=3 or q odd; THM-GRAPH for n=2 and q even >=4",
      "exceptions": [
        "SIMP-SP4-2",
        "Z-SP6-2",
        "Z-SP4-8"
      ]
    },
    {
      "id": "odd_orthogonal",
      "name": "Omega(2n+1,q) = B_n(q)",
      "parameters": "n >= 3 and q odd; q even is routed by B_n(q) ~= C_n(q)",
      "route": "THM-NOGRAPH",
      "exceptions": [
        "ISO-BC-EVEN"
      ]
    },
    {
      "id": "plus_orthogonal",
      "name": "P Omega^+(2n,q) = D_n(q)",
      "parameters": "n >= 4, subject to the standard simple quotient convention",
      "route": "THM-GRAPH",
      "exceptions": [
        "Z-D4-2"
      ]
    },
    {
      "id": "minus_orthogonal",
      "name": "P Omega^-(2n,q) = ^2D_n(q)",
      "parameters": "n >= 4, subject to the standard simple quotient convention",
      "route": "THM-TWISTED-RANKGE2",
      "exceptions": [
        "ISO-2D-LOWRANK"
      ]
    },
    {
      "id": "suzuki",
      "name": "^2B_2(2^f)",
      "parameters": "f odd >= 3",
      "route": "THM-TWISTED-RANK1",
      "exceptions": []
    },
    {
      "id": "small_ree",
      "name": "^2G_2(3^f)",
      "parameters": "f odd >= 3",
      "route": "THM-TWISTED-RANK1",
      "exceptions": [
        "SIMP-REE3"
      ]
    },
    {
      "id": "triality",
      "name": "^3D_4(q)",
      "parameters": "q = p^f",
      "route": "THM-TWISTED-RANKGE2",
      "exceptions": []
    },
    {
      "id": "g2",
      "name": "G_2(q)",
      "parameters": "q >= 3, with G_2(2)' routed to PSU(3,3)",
      "route": "THM-NOGRAPH if p!=3; THM-GRAPH if p=3",
      "exceptions": [
        "SIMP-G2-2"
      ]
    },
    {
      "id": "f4",
      "name": "F_4(q)",
      "parameters": "q = p^f",
      "route": "THM-NOGRAPH if p!=2; THM-GRAPH if p=2",
      "exceptions": []
    },
    {
      "id": "e6",
      "name": "E_6(q)",
      "parameters": "q = p^f, simple central quotient",
      "route": "THM-GRAPH",
      "exceptions": []
    },
    {
      "id": "twisted_e6",
      "name": "^2E_6(q)",
      "parameters": "q = p^f, simple central quotient",
      "route": "THM-TWISTED-RANKGE2",
      "exceptions": []
    },
    {
      "id": "e7",
      "name": "E_7(q)",
      "parameters": "q = p^f, simple central quotient",
      "route": "THM-NOGRAPH",
      "exceptions": []
    },
    {
      "id": "e8",
      "name": "E_8(q)",
      "parameters": "q = p^f",
      "route": "THM-NOGRAPH",
      "exceptions": []
    },
    {
      "id": "large_ree",
      "name": "^2F_4(2^f)",
      "parameters": "f odd >= 3",
      "route": "THM-TWISTED-RANKGE2",
      "exceptions": [
        "SIMP-2F4-2"
      ]
    },
    {
      "id": "tits",
      "name": "^2F_4(2)'",
      "parameters": "the Tits simple group",
      "route": "PROP-SPORADIC",
      "exceptions": []
    },
    {
      "id": "sporadic",
      "name": "the 26 sporadic simple groups",
      "parameters": "exact Atlas list of 26 groups",
      "route": "PROP-SPORADIC plus finite-base certificates for six small sporadics",
      "exceptions": []
    }
  ]
}
